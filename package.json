{
  "name": "home-records-pages",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/finish-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:domain": "node --test tests/domain.test.mjs tests/weekly.test.mjs",
    "check:publish": "node scripts/check-public.mjs",
    "admin:build": "vite build --config vite.admin.config.js",
    "admin": "pnpm admin:build && node server/index.mjs",
    "data:export": "node scripts/export-data.mjs",
    "test:server": "node --test tests/server.test.mjs tests/automation.test.mjs tests/coordinates.test.mjs tests/apartment-map.test.mjs",
    "automation:setup": "node scripts/setup-automation.mjs",
    "data:map": "node scripts/export-apartment-map.mjs"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/point-to-polygon-distance": "7.4.0",
    "fast-xml-parser": "5.11.2",
    "leaflet": "1.9.4",
    "lucide-react": "1.49.0",
    "osmtogeojson": "3.0.0-beta.5",
    "proj4": "2.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
